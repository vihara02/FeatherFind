{
  "expo": {
    "name": "FeatherFind",
    "slug": "featherfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "featherfind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FeatherFind needs camera access to capture photographs of birds for identification and your sighting journal.",
        "NSPhotoLibraryUsageDescription": "FeatherFind needs photo library access to select bird photographs for identification and your sighting journal.",
        "NSLocationWhenInUseUsageDescription": "FeatherFind records GPS coordinates of your bird sightings in the field."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A3C2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
